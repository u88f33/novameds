<%- include( "../partials/header/postlogin" ) -%>

<%
const ship_address = "ship_address";
const ship_city = "ship_city";
const ship_state = "ship_state";
const ship_phone = "ship_phone";
%>

<div class="container">
    <div class="row">

        <div class="order-confirmation">
            <div class="order-confirmation__heading-container">
                <h1 class="order-confirmation__heading">Place an Order</h1>
            </div>

            
            <form action="/profile/cart/checkout" method="POST">
                <div class="order-confirmation__body-container">
                    <div class="order-confirmation__info">
                        <div class="d-flex">
                            <h4>Payment Method</h4>
                            <% if ( paymentSuccess ) { %>
                                <div class="bg-success text-light rounded round-3 ps-5 pe-5 p-2 ms-auto">
                                    <b>Your Payment was successfull</b>
                                </div>  
                            <% } %>

                            <% if ( paymentError ) { %>
                                <div class="bg-danger text-light rounded round-3 ps-5 pe-5 p-2 ms-auto">
                                    <b>Error: Your Payment is Failed (Please try again)</b>
                                </div>  
                            <% } %>
                        </div>
                        <hr />
                        

                        <%# Payment Methods %>
                        <div>
                            <label for="cod_opt">
                                <input
                                    id="cod_opt" 
                                    type="radio" 
                                    name="payment_method"
                                    value="COD"
                                    checked="checked" /> Cash On Delivery
                            </label>
                        </div>

                        <div>
                            <label for="paywithcard_opt">
                                <input 
                                    id="paywithcard_opt" 
                                    type="radio"
                                    name="payment_method" 
                                    value="Card" /> Pay with Credit/Debit Card
                            </label>
                        </div>

                        <div>
                            <label for="easypaisa_opt">
                                <input 
                                    id="easypaisa_opt" 
                                    type="radio"
                                    name="payment_method" 
                                    value="Easypaisa" /> Easypaisa
                            </label>
                        </div>

                        
                        <div class="payment-box__container">
                            
                            <!-- COD -->
                            <div id="COD" class="payment-box__info">
                                <p>No details required. Pay on delivery.</p>
                            </div>

                            <!-- PayWithCard -->
                            <div id="Card" class="payment-box__info">
                                <div class="payment-box__image-container w-100">
                                    <img 
                                        src="/assets/images/debit-card.png"
                                        class="payment-box__image mb-4"
                                        style="width: 300px; border-radius: 5px;"
                                    />
                                </div>
                                <div class="payment-box__admin-account-info">
                                        <h3 class="mb-4">Pay with Credit/Debit Card</h3>
                                        <a href="<%= safpayRedirectUrl %>" class="btn btn-danger mb-3">
                                            Pay with Credit/Debit Card
                                        </a>
                                </div>
                            </div>

                            <!-- Easypaisa -->
                            <div id="Easypaisa" class="payment-box__info">
                                <div class="payment-box__image-container w-100">
                                    <img 
                                        src="/assets/images/easypaisa.png"
                                        class="payment-box__image mb-4"
                                        style="width: 300px; border-radius: 5px;"
                                    />
                                </div>
                                <div class="payment-box__admin-account-info">
                                        <h3>Easypaisa account info</h3>
                                        <p>Send your payments to</p>
                                        <p><b>Account name: </b>Muhammad Umar Farooq</p>
                                        <p><b>Phone number: </b>03185043662</p>
                                        <br /><br />
                                        <p>
                                            After completion of payment, your payment status will be
                                            updated by admin. 
                                        </p>
                                </div>
                            </div>

                        </div>

                        <div class="shipping-form">

                            <!-- Shipping Address -->
                            <h4 class="mt-5">Shipping Address</h4>
                            <hr />
                            
                            <!-- Shipping Address Section -->
                            <div class="shipping-form__section">

                                <!-- Bottom Block -->
                                <div class="shipping-form__group">

                                    <!-- Row 1 -->
                                    <div class="shipping-form__row">
                                        <div class="shipping-form__field">
                                            <label for="ship_address">Shipping Address</label>
                                            <input 
                                                type="text" 
                                                name=<%= ship_address %>
                                                id=<%= ship_address %>
                                                class="shipping-form__input"
                                                required="required" />
                                                <%# Display Shipping Address validation Errors %>
                                                <div class="error-message">
                                                    <% shippingInfoErrors.forEach(error => { %>
                                                        <% if ( error.path == ship_address ) { %>
                                                            <span class="text-danger d-block me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } else { %>
                                                            <span class="text-danger d-none me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } %>
                                                    <% }); %>
                                                </div>
                                        </div>

                                        <div class="shipping-form__field">
                                            <label for="ship_city">City</label>
                                            <input type="text" 
                                                name=<%= ship_city %>
                                                id=<%= ship_city %>
                                                class="shipping-form__input"
                                                required="required" />
                                                <%# Display Shipping City validation Errors %>
                                                <div class="error-message">
                                                    <% shippingInfoErrors.forEach(error => { %>
                                                        <% if ( error.path == ship_city ) { %>
                                                            <span class="text-danger d-block me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } else { %>
                                                            <span class="text-danger d-none me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } %>
                                                    <% }); %>
                                                </div>
                                        </div>
                                    </div>

                                    <!-- Row 2 -->
                                    <div class="shipping-form__row">
                                        <div class="shipping-form__field">
                                            <label for="ship_state">State</label>
                                            <input type="text" 
                                                name=<%= ship_state %> 
                                                id=<%= ship_state %>
                                                value="Pakistan"
                                                class="shipping-form__input"
                                                required="required"
                                                readonly="true" />
                                                <%# Display Shipping State validation Errors %>
                                                <div class="error-message">
                                                    <% shippingInfoErrors.forEach(error => { %>
                                                        <% if ( error.path == ship_state ) { %>
                                                            <span class="text-danger d-block me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } else { %>
                                                            <span class="text-danger d-none me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } %>
                                                    <% }); %>
                                                </div>
                                        </div>

                                        <div class="shipping-form__field">
                                            <label for="ship_phone">Mobile number</label>
                                            <input type="text" 
                                                name=<%= ship_phone %> 
                                                id=<%= ship_phone %>
                                                required="required"
                                                class="shipping-form__input" />
                                                <%# Display Shipping City validation Errors %>
                                                <div class="error-message">
                                                    <% shippingInfoErrors.forEach(error => { %>
                                                        <% if ( error.path == ship_phone ) { %>
                                                            <span class="text-danger d-block me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } else { %>
                                                            <span class="text-danger d-none me-3">
                                                                &#128204; <%= error.msg %>
                                                            </span>
                                                        <% } %>
                                                    <% }); %>
                                                </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Checkbox -->
                                <div class="shipping-form__checkbox">
                                    <label for="same_address">
                                        <input type="checkbox" id="same_address" />
                                        Same as Permanent Address
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Permanent Address -->
                            <h4 class="mt-5">Permanent Address</h4>
                            <hr />
                            
                            <!-- Permanent Address Section -->
                            <div class="shipping-form__section">

                                <!-- Top Block -->
                                <div class="shipping-form__group">

                                    <!-- Row 1 -->
                                    <div class="shipping-form__row">
                                        <div class="shipping-form__field">
                                            <label for="perm_address">Permanent Address</label>
                                            <input type="text" 
                                                name="perm_address" 
                                                id="perm_address" 
                                                class="shipping-form__input" 
                                                required="required" />
                                        </div>

                                        <div class="shipping-form__field">
                                            <label for="perm_city">City</label>
                                            <input type="text" 
                                                name="perm_city" 
                                                id="perm_city" 
                                                class="shipping-form__input" 
                                                required="required" />
                                        </div>
                                    </div>

                                    <!-- Row 2 -->
                                    <div class="shipping-form__row">
                                        <div class="shipping-form__field">
                                            <label for="perm_state">State</label>
                                            <input type="text" 
                                                name="perm_state" 
                                                id="perm_state" 
                                                class="shipping-form__input" 
                                                required="required" />
                                        </div>

                                        <div class="shipping-form__field">
                                            <label for="perm_phone">Mobile Number</label>
                                            <input type="text" 
                                                name="perm_phone" 
                                                id="perm_phone" 
                                                class="shipping-form__input" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>
                    

                    <div class="shopping-cart__order-container">
                        <div class="shopping-cart__order-details">
                            <h3 class="shopping-cart__order-title">Order Summary</h3>
                            <div class="shopping-cart__order-details-row">
                                <p>Subtotal</p>
                                <p>
                                    <i>Rs.</i><%= totalAmount %>
                                </p>
                            </div>
                            <div class="shopping-cart__order-details-row">
                                <p>Delivery Charges</p>
                                <p><i>Rs.</i>300</p>
                            </div>
                            <div class="shopping-cart__order-details-row">
                                <p>Items</p>
                                <p><%= totalCartItems %></p>
                            </div>
                            <div class="shopping-cart__order-details-row">
                                <p><b><i>Total</i></b></p>
                                <p><b>Rs.<%= (totalAmount + 300) %></b></p>
                            </div>
                        </div>

                        <div class="shopping-cart__order-actions">
                            <button type="submit" class="btn btn-dark w-100 fs-5 rounded rounded-1">
                                <b>Confirm Order</b>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    const emptyCartMsg = "<%= emptyCartMsg %>";
    
    if ( emptyCartMsg ) {
        window.alert( emptyCartMsg );
    }

</script>
<script src="/js/scripts/orders/order.js"></script>
<script src="/js/scripts/home/postlogin/search_medicine.js"></script>
<%- include( "../partials/footer/footer" ) -%>