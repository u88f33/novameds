<%- include( "../../../partials/admin/sidebar" ) -%>

<% 

const supplier_name = "supplier_name";
const supplier_email = "supplier_email";
const supplier_phone = "supplier_phone";
const supplier_address = "supplier_address";

%>

<div class="dashboard">
    <header class="dashboard__header">

        <nav class="dashboard__nav">
            <div class="dashboard__nav-title">
                <h1>Dashboard</h1>
            </div>

            <a href="/admin" class="dashboard__profile">

                <div class="dashboard__profile-image-wrapper">
                    <img src="/assets/images/admin.png" class="dashboard__profile-image" />
                </div>

                <div class="dashboard__profile-text">
                    Admin
                </div>

            </a>
        </nav> 
        
    </header>

    <div class="dashboard__section">

        <div class="dashboard__section-main">
            <h3 class="dashboard__section-title">Add Supplier Record</h3>

            <div class="dashboard__secion-form-container">
                <form 
                    action="/admin/manage/suppliers/add"
                    method="POST"
                    class="dashboard__secion-form"
                    >

                <!-- First Row -->
                <div class="dashboard__secion-form-row">
                    
                    <!-- Supplier Name -->
                    <div class="dashboard__secion-form-group">
                        <label for="supplierName" class="dashboard__secion-form-label">Supplier Name</label>
                        <input 
                            type="text" 
                            id="supplierName" 
                            name="<%= supplier_name %>" 
                            class="dashboard__secion-form-input"
                            required="true"
                            maxlength="50"
                            placeholder="Enter Supplier Name"
                        />

                        <%# Display Error Messages on entering Invalid Supplier Name %>
                        <div class="error-message">
                            <% supplierRecordsErrors.forEach(error => { %>
                                <% if ( error.path == supplier_name ) { %>
                                    <span class="text-danger d-block me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } else { %>
                                    <span class="text-danger d-none me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Supplier Email -->
                    <div class="dashboard__secion-form-group">
                        <label for="supplierEmail" class="dashboard__secion-form-label">Supplier Email:</label>
                        <input 
                            type="email" 
                            id="supplierEmail" 
                            name="<%= supplier_email %>" 
                            class="dashboard__secion-form-input"
                            required="true"
                            maxlength="50"
                            placeholder="supplier_email@example.com"
                        />

                        <%# Display Error Messages on entering Invalid Supplier Email %>
                        <div class="error-message">
                            <% supplierRecordsErrors.forEach(error => { %>
                                <% if ( error.path == supplier_email ) { %>
                                    <span class="text-danger d-block me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } else { %>
                                    <span class="text-danger d-none me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>

                </div>

                <!-- Second Row -->
                <div class="dashboard__secion-form-row">
                    
                    <!-- Customer Phone -->
                    <div class="dashboard__secion-form-group">
                        <label for="supplierPhone" class="dashboard__secion-form-label">Supplier Phone</label>
                        <input 
                            type="text" 
                            id="supplierPhone" 
                            name="<%= supplier_phone %>" 
                            class="dashboard__secion-form-input"
                            required="true"
                            maxlength="50"
                            placeholder="03331234567"
                        />

                        <%# Display Error Messages on entering Invalid Supplier Email %>
                        <div class="error-message">
                            <% supplierRecordsErrors.forEach(error => { %>
                                <% if ( error.path == supplier_phone ) { %>
                                    <span class="text-danger d-block me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } else { %>
                                    <span class="text-danger d-none me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Customer Address -->
                    <div class="dashboard__secion-form-group">
                        <label for="supplierAddress" class="dashboard__secion-form-label">Supplier Address</label>
                        <input 
                            type="text" 
                            id="supplierAddress" 
                            name="<%= supplier_address %>" 
                            class="dashboard__secion-form-input"
                            required="required"
                            placeholder="I-8 Islamabad"
                        />
                        <%# Display Error Messages on entering Invalid Supplier Address %>
                        <div class="error-message">
                            <% supplierRecordsErrors.forEach(error => { %>
                                <% if ( error.path == supplier_address ) { %>
                                    <span class="text-danger d-block me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } else { %>
                                    <span class="text-danger d-none me-3">
                                        &#128204; <%= error.msg %>
                                    </span>
                                <% } %>
                            <% }); %>
                        </div>

                    </div>

                </div>

                <div class="dashboard__secion-form-actions">
                    <button type="submit" class="dashboard__secion-form-button">
                        Add Supplier Record
                    </button>
                    <a href="/admin/manage/suppliers" class="dashboard__secion-action-button">
                        Go Back
                    </a>
                </div>

                </form>
            </div>


        </div>

        <% if ( message ) { %>
            <div class="dashboard__section-main mt-5">
                <p class="alert alert-primary mt-5 mb-4 border border-primary">
                    <%= message  %>
                </p>
            </div>
        <% } %>

        <% if ( errorMessage ) { %>
            <div class="dashboard__section-main mt-5">
                <p class="alert alert-danger mt-5 mb-4 border border-danger text-danger">
                    <%= errorMessage  %>
                </p>
            </div>
        <% } %>

    </div>
</div>

<%- include( "../../../partials/admin/footer" ) -%>